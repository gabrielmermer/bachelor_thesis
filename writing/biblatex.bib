@article{copaceanuUsingVoiceInput2024,
  title = {Using {{Voice Input}} to {{Control}} and {{Interact With}} a {{Narrative Video Game}}},
  author = {Copaceanu, Andrei and Weinel, Jonathan and Cunningham, Stuart},
